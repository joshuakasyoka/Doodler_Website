# Copy to .env.local for local development. All variables are optional.
# Validated at build time by lib/env.ts.

# Canonical origin for canonical URLs, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://doodler.app

# Image CDN base URL. Leave empty to use Next.js's built-in optimiser.
NEXT_PUBLIC_IMAGE_CDN_URL=

# Analytics id. Nothing loads until the visitor consents (components/layout/consent-slot.tsx).
NEXT_PUBLIC_ANALYTICS_ID=

# Payments (server only). The payments service is a stub until these are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
